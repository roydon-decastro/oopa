# Neon: Dashboard > your project > Connect (use the pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Vercel Blob for listing photos (Vercel > Storage > Blob). Leave unset locally to store photos in ./.uploads
BLOB_READ_WRITE_TOKEN=
# Public site address (used for links in emails, sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://oopa-seven.vercel.app
# Shown on the Terms and Privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Email alerts via https://resend.com (free tier). Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=Oopa <onboarding@resend.dev>
